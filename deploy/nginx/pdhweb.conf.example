# ==============================================================================
# PDHWeb - Pluak Daeng Hospital Web Application
# Nginx Server Configuration Example for Ubuntu 24.04 + PHP 8.4-FPM
# ==============================================================================
# Document Root: /var/www/test/source/public
# Replace 'test.pluakdaenghospital.cloud' with your actual domain or subdomain.
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name test.pluakdaenghospital.cloud;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.pluakdaenghospital.cloud;

    # Document Root MUST point to the /public directory
    root /var/www/test/source/public;
    index index.php index.html;

    # SSL Configuration (Replace with your actual Certbot / Let's Encrypt paths)
    # ssl_certificate /etc/letsencrypt/live/test.pluakdaenghospital.cloud/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/test.pluakdaenghospital.cloud/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Character Set & Logs
    charset utf-8;
    access_log /var/log/nginx/pdhweb_access.log;
    error_log /var/log/nginx/pdhweb_error.log warn;

    # Maximum file upload size (matches PHP post_max_size / upload_max_filesize)
    client_max_body_size 64M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # 1. Front Controller Routing
    # Routes all pretty URLs (e.g. /admin/login, /news, /services) to index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 2. Static Asset Caching (CSS, JS, Images, Fonts)
    location ~* \.(jpg|jpeg|png|gif|ico|webp|svg|css|js|woff|woff2|ttf|eot|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
        access_log off;
    }

    # 3. PHP 8.4-FPM Processing
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        include fastcgi_params;

        # Timeouts and Buffers
        fastcgi_read_timeout 300;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }

    # 4. Security Rules: Block Hidden & Sensitive Files
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(env|log|sql|git|md|yml|yaml|ini|json|bak|config|sh)$ {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    # 5. Block direct access to internal directories (in case docroot misconfiguration)
    location ~ ^/(app|config|database|deploy|routes|vendor)/ {
        deny all;
        return 404;
    }
}
